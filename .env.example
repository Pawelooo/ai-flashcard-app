SECRET_KEY=replace-with-random-50-char-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=NaukaAI <noreply@yourdomain.com>

# Produkcja (Fly.io):
# REDIS_URL=rediss://<upstash-endpoint>:<port>
# DATABASE_URL=postgresql://...
# Opcjonalnie: domyślnie przy DEBUG=1 maile idą do konsoli runservera, inaczej SMTP (Resend)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Claude API — quiz ABCD i ocena odpowiedzi. Na produkcji: fly secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium
